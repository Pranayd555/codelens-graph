{
  "name": "codelens-graph",
  "displayName": "CodeLens Graph",
  "description": "Builds a live knowledge graph of your codebase so AI agents understand everything before acting.",
  "version": "0.3.1",
  "publisher": "PranayDas",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pranayd555/codelens-graph.git"
  },
  "icon": "assets/code-lens-graph-logo.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "keywords": [
    "ai agent",
    "knowledge graph",
    "context builder",
    "token reduction",
    "dependency graph"
  ],
  "galleryBanner": {
    "color": "#f4845f",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Visualization",
    "Linters",
    "Snippets",
    "Debuggers",
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "CodeLens Graph only indexes the workspace and writes agent configuration files once the workspace is trusted."
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "node esbuild.js",
    "compile:prod": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "node esbuild.js --production && npx @vscode/vsce package --allow-missing-repository --no-git-tag-version"
  },
  "contributes": {
    "commands": [
      {
        "command": "codelens-graph.buildGraph",
        "title": "CodeLens: Build Knowledge Graph"
      },
      {
        "command": "codelens-graph.rebuildGraph",
        "title": "CodeLens: Force Rebuild Graph"
      },
      {
        "command": "codelens-graph.showGraph",
        "title": "CodeLens: Show Graph Explorer"
      },
      {
        "command": "codelens-graph.showContext",
        "title": "CodeLens: Show Agent Context Preview"
      },
      {
        "command": "codelens-graph.searchSymbol",
        "title": "CodeLens: Search Symbol in Graph"
      },
      {
        "command": "codelens-graph.getContextForTask",
        "title": "CodeLens: Get Context for Task (Agent)"
      },
      {
        "command": "codelens-graph.updateAfterAgentRun",
        "title": "CodeLens: Update Graph After Agent Run"
      },
      {
        "command": "codelens-graph.regenerateSkills",
        "title": "CodeLens: Regenerate AI Agent Skill Files"
      },
      {
        "command": "codelens-graph.copyMcpConfig",
        "title": "CodeLens: Copy MCP Config to Clipboard"
      },
      {
        "command": "codelens-graph.showMcpUsage",
        "title": "CodeLens: Show MCP Usage Report"
      },
      {
        "command": "codelens-graph.clearConfig",
        "title": "CodeLens: Clear Configuration Files and Reset State"
      },
      {
        "command": "codelens-graph.selectIndexedFolders",
        "title": "CodeLens: Select Indexed Folders…",
        "icon": "$(list-selection)"
      },
      {
        "command": "codelens-graph.indexEntireWorkspace",
        "title": "CodeLens: Index Entire Workspace",
        "icon": "$(root-folder)"
      },
      {
        "command": "codelens-graph.refreshIndexedFolders",
        "title": "CodeLens: Refresh Indexed Folders",
        "icon": "$(refresh)"
      },
      {
        "command": "codelens-graph.enableWorkspace",
        "title": "CodeLens: Turn On for This Workspace"
      },
      {
        "command": "codelens-graph.disableWorkspace",
        "title": "CodeLens: Turn Off for This Workspace"
      }
    ],
    "menus": {
      "view/title": [
        { "command": "codelens-graph.selectIndexedFolders", "when": "view == codelens-graph.indexedFolders && codelens.workspaceEnabled", "group": "navigation@1" },
        { "command": "codelens-graph.indexEntireWorkspace", "when": "view == codelens-graph.indexedFolders && codelens.workspaceEnabled", "group": "navigation@2" },
        { "command": "codelens-graph.refreshIndexedFolders", "when": "view == codelens-graph.indexedFolders && codelens.workspaceEnabled", "group": "navigation@3" }
      ],
      "commandPalette": [
        { "command": "codelens-graph.refreshIndexedFolders", "when": "false" },
        { "command": "codelens-graph.enableWorkspace", "when": "workspaceFolderCount > 0 && !codelens.workspaceEnabled" },
        { "command": "codelens-graph.disableWorkspace", "when": "codelens.workspaceEnabled" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codelens-graph-sidebar",
          "title": "CodeLens Graph",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codelens-graph.indexedFolders",
        "contents": "CodeLens Graph is off for this workspace. Nothing is indexed and no files are created.\n[Turn On for This Workspace](command:codelens-graph.enableWorkspace)\nOnly this workspace is affected; other windows keep their own setting.",
        "when": "workspaceFolderCount > 0 && !codelens.workspaceEnabled"
      }
    ],
    "views": {
      "codelens-graph-sidebar": [
        {
          "id": "codelens-graph.statsView",
          "name": "Graph Stats",
          "type": "webview",
          "icon": "$(type-hierarchy)"
        },
        {
          "id": "codelens-graph.indexedFolders",
          "name": "Indexed Folders",
          "type": "tree",
          "icon": "$(list-tree)"
        }
      ]
    },
    "configuration": {
      "title": "CodeLens Graph",
      "properties": {
        "codeLensGraph.autoRebuildOnSave": {
          "type": "boolean",
          "default": true
        },
        "codeLensGraph.maxGraphDepth": {
          "type": "number",
          "default": 2
        },
        "codeLensGraph.maxTokenBudget": {
          "type": "number",
          "default": 2000
        },
        "codeLensGraph.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/output/**",
            "**/bundle/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/.svelte-kit/**",
            "**/.vite/**",
            "**/.turbo/**",
            "**/.parcel-cache/**",
            "**/.cache/**",
            "**/.angular/**",
            "**/coverage/**",
            "**/.nyc_output/**",
            "**/playwright-report/**",
            "**/test-results/**",
            "**/__pycache__/**",
            "**/.venv/**",
            "**/venv/**",
            "**/.pytest_cache/**",
            "**/.mypy_cache/**",
            "**/site-packages/**",
            "**/*.egg-info/**",
            "**/vendor/**",
            "**/target/**",
            "**/.gradle/**",
            "**/.m2/**",
            "**/obj/**",
            "**/.git/**",
            "**/.hg/**",
            "**/.svn/**",
            "**/.idea/**",
            "**/.vs/**",
            "**/.vscode/**",
            "**/.cursor/**",
            "**/.trae/**",
            "**/.codelens/**",
            "**/DerivedData/**",
            "**/xcuserdata/**",
            "**/.build/**"
          ],
          "description": "Glob patterns for directories and files to exclude from graph indexing."
        },
        "codeLensGraph.includeFolders": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Workspace-relative folders to index (e.g. `src`, `packages/api`). Empty means the whole workspace. Files directly in the workspace root (`package.json`, `tsconfig.json`, …) are always indexed. A folder listed here is indexed even if its name is normally skipped (e.g. `build`). Easiest to manage from the **Indexed Folders** view."
        },
        "codeLensGraph.largeWorkspaceThreshold": {
          "type": "number",
          "default": 5000,
          "minimum": 0,
          "markdownDescription": "When a workspace has never been indexed, has no folder selection, and contains more indexable files than this, CodeLens asks which folders to index instead of indexing everything."
        },
        "codeLensGraph.supportedExtensions": {
          "type": "array",
          "default": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx",
            ".py",
            ".go",
            ".rs",
            ".java",
            ".cs",
            ".cpp",
            ".c",
            ".rb",
            ".php"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "d3": "^7.9.0",
    "sql.js": "^1.11.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.95.0",
    "chokidar": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.0"
  },
  "bin": {
    "codelens-mcp": "./dist/mcp.js"
  }
}
