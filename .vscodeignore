# Everything excluded by default, then we whitelist what's needed

# Source and build artifacts not needed at runtime
src/**
out/**
.vscode-test/**
.github/**
esbuild.js
tsconfig.json
*.vsix
*.map
.eslintrc*
.prettierrc*

# Exclude ALL of node_modules — the dist/ bundles include everything needed
node_modules/**

# Misc
.codelens/**
.agents/**
.vscode/**
knowledge.md
Thumbs.db
*.log
